{
  "manifest_version": 3,
  "name": "RILDON — Integração X2",
  "version": "3.3.0",
  "description": "Teste de captura da confirmação X2 na página e nos diálogos nativos, com diagnóstico.",
  "permissions": [
    "storage",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": [
    "https://sistemas7.xprocess.com.br/x2rildon/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://sistemas7.xprocess.com.br/x2rildon/pedido/venda/relativo/vendas/produtos_vendidos.jsp",
        "https://sistemas7.xprocess.com.br/x2rildon/pedido/venda/relatorio/vendas/produtos_vendidos.jsp"
      ],
      "js": [
        "captura.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": [
        "https://sistemas7.xprocess.com.br/x2rildon/*"
      ],
      "js": [
        "rupturas_carrinho.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://sistemas7.xprocess.com.br/*"
      ],
      "js": [
        "sinalizacao_pagina.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://sistemas7.xprocess.com.br/*"
      ],
      "js": [
        "sinalizacao_captura.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "RILDON — Captura de Procura X2",
    "default_popup": "popup.html"
  },
  "externally_connectable": {
    "matches": [
      "http://*/*",
      "http://localhost/*",
      "http://127.0.0.1/*"
    ]
  }
}